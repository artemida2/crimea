---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../utils/url";
import places from "../../data/map-places.json";

const imageBase = url("img/");

const description =
  "Интерактивная карта Крыма: природа, история, пляжи и гастрономия на одной карте. Фильтры по категориям, поиск, описания мест и сборка собственного маршрута.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Интерактивная карта мест Крыма",
  numberOfItems: places.length,
  itemListElement: places.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "TouristAttraction",
      name: p.name,
      address: p.city,
      geo: { "@type": "GeoCoordinates", latitude: p.lat, longitude: p.lng },
    },
  })),
};
---

<BaseLayout
  title="Карта Крыма — интерактивная карта мест"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Leaflet + MarkerCluster (бесплатные CDN, без бэкенда и ключей) -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
  />

  <div class="container" style="padding-top: var(--s-4);">
    <p class="breadcrumbs">
      <a href={url()}>Главная</a><span class="sep">/</span>Карта
    </p>
  </div>

  <header class="karta-head container">
    <span class="eyebrow">Интерактивная карта</span>
    <h1 style="font-style: italic;">Места Крыма на карте</h1>
    <p class="muted karta-sub">
      Природа, история, пляжи и гастрономия — фильтруйте, ищите и собирайте
      собственный маршрут. Ссылкой на маршрут можно поделиться.
    </p>
  </header>

  <section class="karta-wrap">
    <!-- Поиск + фильтры -->
    <div class="map-controls">
      <div class="search-box">
        <svg class="search-ic" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm5 12 4 4"/></svg>
        <input
          id="map-search"
          type="search"
          placeholder="Поиск по названию или городу…"
          autocomplete="off"
          aria-label="Поиск по названию или городу"
        />
      </div>
      <div class="filters" id="filters" role="group" aria-label="Фильтры категорий">
        <button class="pill" data-cat="all" type="button">Все</button>
        <button class="pill" data-cat="nature" type="button">Природа</button>
        <button class="pill" data-cat="history" type="button">История</button>
        <button class="pill" data-cat="beach" type="button">Пляжи</button>
        <button class="pill" data-cat="food" type="button">Еда</button>
      </div>
    </div>

    <!-- Карта + оверлеи -->
    <div class="map-shell">
      <div id="map" role="application" aria-label="Карта мест Крыма"></div>

      <!-- Боковая панель места -->
      <aside class="place-panel" id="place-panel" aria-hidden="true">
        <button class="panel-close" id="panel-close" type="button" aria-label="Закрыть">
          <svg viewBox="0 0 24 24" width="20" height="20"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <div class="panel-media" id="panel-media"></div>
        <div class="panel-body">
          <span class="badge" id="panel-badge"></span>
          <div class="panel-title-row">
            <h2 id="panel-name"></h2>
            <span class="rating" id="panel-rating"></span>
          </div>
          <p class="panel-meta" id="panel-meta"></p>
          <p class="panel-desc" id="panel-desc"></p>
          <div class="panel-actions">
            <button class="btn btn-route" id="panel-add" type="button">+ В маршрут</button>
            <button class="btn btn-ghost" id="panel-focus" type="button">На карте</button>
          </div>
        </div>
      </aside>

      <!-- Полоска маршрута -->
      <div class="route-bar" id="route-bar">
        <span class="route-bar-text" id="route-bar-text">Маршрут: 0 мест выбрано</span>
        <button class="btn btn-route" id="route-open" type="button" disabled>
          Посмотреть маршрут →
        </button>
      </div>
    </div>
  </section>

  <!-- Модальное окно маршрута -->
  <div class="modal-overlay" id="route-modal" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-head">
        <h2 id="modal-title">Ваш маршрут</h2>
        <button class="panel-close" id="modal-close" type="button" aria-label="Закрыть">
          <svg viewBox="0 0 24 24" width="20" height="20"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <p class="route-hint" id="route-hint">Маршрут показан зелёной линией на карте, цифры — порядок посещения. Меняйте порядок стрелками.</p>
      <ol class="route-list" id="route-list"></ol>
      <p class="route-empty" id="route-empty">Пока ничего не выбрано. Откройте место на карте и нажмите «+ В маршрут».</p>
      <div class="modal-actions">
        <button class="btn btn-route" id="route-pdf" type="button">Скачать PDF</button>
        <button class="btn btn-ghost" id="route-mapbtn" type="button">На карте</button>
        <button class="btn btn-ghost" id="route-share" type="button">Поделиться</button>
      </div>
      <p class="share-hint" id="share-hint"></p>
    </div>
  </div>

  <!-- Печатная версия маршрута -->
  <div class="print-route" id="print-route" aria-hidden="true"></div>

  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script
    is:inline
    src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
  ></script>

  <script is:inline define:vars={{ places, imageBase }}>
    (function () {
      const CATS = {
        nature:  { color: "#1D9E75", label: "Природа", badge: "Природа",
          icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>' },
        history: { color: "#534AB7", label: "История", badge: "История",
          icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 6 12 2l9 4v2H3V6zM5 9h2v8H5V9zm6 0h2v8h-2V9zm6 0h2v8h-2V9zM3 18h18v3H3v-3z"/></svg>' },
        beach:   { color: "#BA7517", label: "Пляжи", badge: "Пляж",
          icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 11c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M2 17c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/></svg>' },
        food:    { color: "#D4537E", label: "Еда", badge: "Еда",
          icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6 2v7a2 2 0 0 0 1.5 1.94V22h1.5V10.94A2 2 0 0 0 10.5 9V2H9v6.5H8V2H6.5v6.5h-1V2H6zm10 0c-1.66 0-3 2.46-3 5.5 0 2.3 1 3.6 2.25 3.93V22h1.5V2H16z"/></svg>' },
      };
      const byId = {};
      places.forEach((p) => (byId[p.id] = p));

      // ---------- map ----------
      const map = L.map("map", { zoomControl: true, scrollWheelZoom: true })
        .setView([44.95, 34.1], 9);
      L.tileLayer(
        "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
        {
          maxZoom: 19,
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        }
      ).addTo(map);

      // слой для линии маршрута и порядковых номеров (поверх кластера)
      const routeLayer = L.layerGroup().addTo(map);

      function pinHtml(cat) {
        const c = CATS[cat];
        return (
          '<div class="pin" style="border-color:' + c.color + ';color:' + c.color + '">' +
          c.icon + "</div>"
        );
      }
      function makeMarker(p) {
        const m = L.marker([p.lat, p.lng], {
          icon: L.divIcon({
            className: "pin-wrap",
            html: pinHtml(p.category),
            iconSize: [36, 36],
            iconAnchor: [18, 18],
            popupAnchor: [0, -18],
          }),
        });
        m.placeId = p.id;
        m.category = p.category;
        m.on("click", () => openPanel(p.id));
        return m;
      }

      const markers = {};
      places.forEach((p) => (markers[p.id] = makeMarker(p)));

      const cluster = L.markerClusterGroup({
        showCoverageOnHover: false,
        maxClusterRadius: 50,
        iconCreateFunction: function (c) {
          const counts = {};
          c.getAllChildMarkers().forEach((m) => {
            counts[m.category] = (counts[m.category] || 0) + 1;
          });
          let top = "nature", max = -1;
          Object.keys(counts).forEach((k) => {
            if (counts[k] > max) { max = counts[k]; top = k; }
          });
          const color = CATS[top].color;
          return L.divIcon({
            className: "cluster-wrap",
            html:
              '<div class="cluster" style="background:' + color + '">' +
              c.getChildCount() + "</div>",
            iconSize: [40, 40],
          });
        },
      });
      map.addLayer(cluster);

      // ---------- filters + search ----------
      const active = new Set(["nature", "history", "beach", "food"]);
      let query = "";

      function matches(p) {
        if (!query) return true;
        const q = query.toLowerCase();
        return (
          p.name.toLowerCase().includes(q) || p.city.toLowerCase().includes(q)
        );
      }

      function applyFilters() {
        const visible = [];
        places.forEach((p) => {
          const m = markers[p.id];
          if (active.has(p.category)) {
            if (!cluster.hasLayer(m)) cluster.addLayer(m);
            visible.push(m);
            m.setOpacity(matches(p) ? 1 : 0.3);
          } else if (cluster.hasLayer(m)) {
            cluster.removeLayer(m);
          }
        });
        // refresh cluster opacity for dimming
        cluster.refreshClusters();
      }

      // pills
      const filterEl = document.getElementById("filters");
      function stylePill(btn) {
        const cat = btn.dataset.cat;
        let on;
        if (cat === "all") {
          on = active.size === 4;
          btn.style.background = on ? "#1a1a1a" : "#fff";
          btn.style.color = on ? "#fff" : "#6b7280";
          btn.style.borderColor = on ? "#1a1a1a" : "#e5e7eb";
        } else {
          on = active.has(cat);
          const color = CATS[cat].color;
          btn.style.background = on ? color : "#fff";
          btn.style.color = on ? "#fff" : "#6b7280";
          btn.style.borderColor = on ? color : "#e5e7eb";
        }
        btn.classList.toggle("pill-on", on);
      }
      function refreshPills() {
        filterEl.querySelectorAll(".pill").forEach(stylePill);
      }
      filterEl.querySelectorAll(".pill").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cat = btn.dataset.cat;
          if (cat === "all") {
            ["nature", "history", "beach", "food"].forEach((c) => active.add(c));
          } else {
            if (active.has(cat)) active.delete(cat);
            else active.add(cat);
            if (active.size === 0) {
              // не оставляем пустую карту — возвращаем эту категорию
              active.add(cat);
            }
          }
          refreshPills();
          applyFilters();
        });
      });

      const searchEl = document.getElementById("map-search");
      searchEl.addEventListener("input", () => {
        query = searchEl.value.trim();
        applyFilters();
      });

      // ---------- side panel ----------
      const panel = document.getElementById("place-panel");
      let panelId = null;

      function srcFor(p) {
        if (!p.image) return null;
        return /^https?:/.test(p.image)
          ? p.image
          : imageBase + p.image + "-800.webp";
      }
      function imgFor(p) {
        const src = srcFor(p);
        if (src) {
          return (
            '<img src="' + src + '" alt="' + esc(p.name) +
            '" loading="lazy" referrerpolicy="no-referrer" />'
          );
        }
        const c = CATS[p.category];
        return (
          '<div class="media-ph" style="background:' + c.color + '">' +
          c.icon.replace('width="16" height="16"', 'width="48" height="48"') +
          "</div>"
        );
      }
      function esc(s) {
        return String(s).replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
        );
      }

      function openPanel(id) {
        const p = byId[id];
        if (!p) return;
        panelId = id;
        const c = CATS[p.category];
        document.getElementById("panel-media").innerHTML = imgFor(p);
        const badge = document.getElementById("panel-badge");
        badge.textContent = c.badge;
        badge.style.background = c.color;
        document.getElementById("panel-name").textContent = p.name;
        document.getElementById("panel-rating").innerHTML =
          '<span class="star">★</span>' + p.rating.toFixed(1);
        document.getElementById("panel-meta").textContent =
          p.city + " · " + p.duration;
        document.getElementById("panel-desc").textContent = p.description;
        updateAddBtn();
        panel.classList.add("open");
        panel.setAttribute("aria-hidden", "false");
      }
      function closePanel() {
        panel.classList.remove("open");
        panel.setAttribute("aria-hidden", "true");
        panelId = null;
      }
      document.getElementById("panel-close").addEventListener("click", closePanel);
      document.getElementById("panel-focus").addEventListener("click", () => {
        const p = byId[panelId];
        if (!p) return;
        map.flyTo([p.lat, p.lng], Math.max(map.getZoom(), 13), { duration: 0.6 });
      });
      document.getElementById("panel-add").addEventListener("click", () => {
        if (!panelId) return;
        toggleRoute(panelId);
        updateAddBtn();
      });
      function updateAddBtn() {
        const btn = document.getElementById("panel-add");
        if (route.includes(panelId)) {
          btn.textContent = "− Убрать из маршрута";
          btn.classList.add("btn-ghost");
          btn.classList.remove("btn-route");
        } else {
          btn.textContent = "+ В маршрут";
          btn.classList.add("btn-route");
          btn.classList.remove("btn-ghost");
        }
      }

      // ---------- route ----------
      let route = [];
      const routeBarText = document.getElementById("route-bar-text");
      const routeOpenBtn = document.getElementById("route-open");

      function toggleRoute(id) {
        const i = route.indexOf(id);
        if (i === -1) route.push(id);
        else route.splice(i, 1);
        refreshRouteBar();
      }
      function refreshRouteBar() {
        const n = route.length;
        const word = pluralPlaces(n);
        routeBarText.textContent = "Маршрут: " + n + " " + word + " выбрано";
        routeOpenBtn.disabled = n === 0;
        drawRoute();
      }

      // рисуем линию маршрута и порядковые номера прямо на карте
      function drawRoute() {
        routeLayer.clearLayers();
        if (route.length === 0) return;
        const pts = route.map((id) => [byId[id].lat, byId[id].lng]);
        if (pts.length > 1) {
          L.polyline(pts, {
            color: "#1D9E75",
            weight: 4,
            opacity: 0.9,
            dashArray: "2 9",
            lineCap: "round",
            lineJoin: "round",
          }).addTo(routeLayer);
        }
        route.forEach((id, i) => {
          const p = byId[id];
          L.marker([p.lat, p.lng], {
            icon: L.divIcon({
              className: "order-wrap",
              html: '<div class="order-badge">' + (i + 1) + "</div>",
              iconSize: [22, 22],
              iconAnchor: [-6, 28],
            }),
            zIndexOffset: 1000,
            interactive: false,
            keyboard: false,
          }).addTo(routeLayer);
        });
      }
      function fitRoute() {
        if (route.length < 1) return;
        const pts = route.map((id) => [byId[id].lat, byId[id].lng]);
        map.fitBounds(L.latLngBounds(pts), { padding: [60, 60], maxZoom: 13 });
      }
      function pluralPlaces(n) {
        const m10 = n % 10, m100 = n % 100;
        if (m10 === 1 && m100 !== 11) return "место";
        if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return "места";
        return "мест";
      }

      // modal
      const modal = document.getElementById("route-modal");
      const routeListEl = document.getElementById("route-list");
      const routeEmptyEl = document.getElementById("route-empty");
      const shareHint = document.getElementById("share-hint");

      function openModal() {
        renderRouteList();
        modal.classList.add("open");
        modal.setAttribute("aria-hidden", "false");
      }
      function closeModal() {
        modal.classList.remove("open");
        modal.setAttribute("aria-hidden", "true");
        shareHint.textContent = "";
      }
      routeOpenBtn.addEventListener("click", openModal);
      document.getElementById("modal-close").addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      const routeHint = document.getElementById("route-hint");
      const routeMapBtn = document.getElementById("route-mapbtn");
      routeMapBtn.addEventListener("click", () => {
        closeModal();
        fitRoute();
      });

      function renderRouteList() {
        routeListEl.innerHTML = "";
        routeEmptyEl.style.display = route.length ? "none" : "block";
        routeHint.style.display = route.length ? "block" : "none";
        routeMapBtn.disabled = route.length === 0;
        route.forEach((id, idx) => {
          const p = byId[id];
          const c = CATS[p.category];
          const li = document.createElement("li");
          li.className = "route-item";
          li.innerHTML =
            '<span class="dot" style="background:' + c.color + '"></span>' +
            '<span class="ri-body"><span class="ri-name">' + esc(p.name) +
            '</span><span class="ri-meta">' + esc(p.city) + " · " + esc(p.duration) +
            "</span></span>" +
            '<span class="ri-ctl">' +
            '<button type="button" data-act="up" aria-label="Выше"' + (idx === 0 ? " disabled" : "") + ">↑</button>" +
            '<button type="button" data-act="down" aria-label="Ниже"' + (idx === route.length - 1 ? " disabled" : "") + ">↓</button>" +
            '<button type="button" data-act="del" aria-label="Удалить">✕</button>' +
            "</span>";
          li.querySelector('[data-act="up"]').addEventListener("click", () => {
            if (idx > 0) { [route[idx - 1], route[idx]] = [route[idx], route[idx - 1]]; renderRouteList(); refreshRouteBar(); }
          });
          li.querySelector('[data-act="down"]').addEventListener("click", () => {
            if (idx < route.length - 1) { [route[idx + 1], route[idx]] = [route[idx], route[idx + 1]]; renderRouteList(); refreshRouteBar(); }
          });
          li.querySelector('[data-act="del"]').addEventListener("click", () => {
            route.splice(idx, 1); renderRouteList(); refreshRouteBar(); updateAddBtn();
          });
          routeListEl.appendChild(li);
        });
      }

      // ---------- статическая карта маршрута для PDF ----------
      const TILE = 256;
      function projectPx(lat, lng, z) {
        const s = TILE * Math.pow(2, z);
        const x = ((lng + 180) / 360) * s;
        const sinL = Math.sin((lat * Math.PI) / 180);
        const y = (0.5 - Math.log((1 + sinL) / (1 - sinL)) / (4 * Math.PI)) * s;
        return { x, y };
      }
      function buildRouteMap(ids) {
        return new Promise((resolve) => {
          const W = 760, H = 420, pad = 54;
          const pts = ids.map((id) => byId[id]).filter(Boolean);
          if (!pts.length) { resolve(null); return; }
          let z = 13;
          if (pts.length > 1) {
            for (z = 13; z >= 3; z--) {
              const pr = pts.map((p) => projectPx(p.lat, p.lng, z));
              const w = Math.max(...pr.map((q) => q.x)) - Math.min(...pr.map((q) => q.x));
              const h = Math.max(...pr.map((q) => q.y)) - Math.min(...pr.map((q) => q.y));
              if (w <= W - 2 * pad && h <= H - 2 * pad) break;
            }
          }
          if (z < 3) z = 3;
          const proj = pts.map((p) => projectPx(p.lat, p.lng, z));
          const cx = (Math.min(...proj.map((q) => q.x)) + Math.max(...proj.map((q) => q.x))) / 2;
          const cy = (Math.min(...proj.map((q) => q.y)) + Math.max(...proj.map((q) => q.y))) / 2;
          const originX = cx - W / 2, originY = cy - H / 2;
          const canvas = document.createElement("canvas");
          canvas.width = W; canvas.height = H;
          const ctx = canvas.getContext("2d");
          ctx.fillStyle = "#e8ecef"; ctx.fillRect(0, 0, W, H);
          const t0x = Math.floor(originX / TILE), t1x = Math.floor((originX + W) / TILE);
          const t0y = Math.floor(originY / TILE), t1y = Math.floor((originY + H) / TILE);
          const maxT = Math.pow(2, z), sub = ["a", "b", "c"], tiles = [];
          for (let tx = t0x; tx <= t1x; tx++)
            for (let ty = t0y; ty <= t1y; ty++) {
              if (ty < 0 || ty >= maxT) continue;
              tiles.push({ tx, ty, wx: ((tx % maxT) + maxT) % maxT });
            }
          let loaded = 0, finished = false;
          function finish() {
            if (finished) return;
            finished = true;
            ctx.lineWidth = 4; ctx.strokeStyle = "#1D9E75";
            ctx.lineCap = "round"; ctx.lineJoin = "round";
            ctx.setLineDash([2, 9]);
            ctx.beginPath();
            proj.forEach((q, i) => {
              const X = q.x - originX, Y = q.y - originY;
              i ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y);
            });
            if (proj.length > 1) ctx.stroke();
            ctx.setLineDash([]);
            proj.forEach((q, i) => {
              const X = q.x - originX, Y = q.y - originY;
              ctx.beginPath(); ctx.arc(X, Y, 12, 0, 2 * Math.PI);
              ctx.fillStyle = "#1D9E75"; ctx.fill();
              ctx.lineWidth = 2; ctx.strokeStyle = "#fff"; ctx.stroke();
              ctx.fillStyle = "#fff";
              ctx.font = "bold 13px Inter, Arial, sans-serif";
              ctx.textAlign = "center"; ctx.textBaseline = "middle";
              ctx.fillText(String(i + 1), X, Y);
            });
            let url = null;
            try { url = canvas.toDataURL("image/jpeg", 0.85); } catch (e) { url = null; }
            resolve(url);
          }
          if (!tiles.length) { finish(); return; }
          tiles.forEach((t, idx) => {
            const img = new Image();
            img.crossOrigin = "anonymous";
            img.onload = () => {
              ctx.drawImage(img, t.tx * TILE - originX, t.ty * TILE - originY, TILE, TILE);
              if (++loaded >= tiles.length) finish();
            };
            img.onerror = () => { if (++loaded >= tiles.length) finish(); };
            img.src = "https://" + sub[idx % 3] + ".basemaps.cartocdn.com/light_all/" + z + "/" + t.wx + "/" + t.ty + ".png";
          });
          setTimeout(finish, 4500);
        });
      }
      function waitImages(el, ms) {
        const imgs = Array.prototype.slice.call(el.querySelectorAll("img"));
        if (!imgs.length) return Promise.resolve();
        return Promise.race([
          Promise.all(imgs.map((im) =>
            im.complete ? Promise.resolve() : new Promise((r) => { im.onload = im.onerror = r; })
          )),
          new Promise((r) => setTimeout(r, ms)),
        ]);
      }

      // PDF via print — красивый макет с картой маршрута
      document.getElementById("route-pdf").addEventListener("click", async (e) => {
        if (!route.length) return;
        const btn = e.currentTarget;
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Готовим PDF…";
        const box = document.getElementById("print-route");
        const mapUrl = await buildRouteMap(route);
        let html =
          '<div class="pr-head"><div class="pr-brand">Крым · издание о полуострове</div>' +
          "<h1>Мой маршрут по Крыму</h1>" +
          '<div class="pr-sub">' + route.length + " " + pluralPlaces(route.length) +
          " · welcomecrimea.ru</div></div>";
        if (mapUrl) html += '<img class="pr-map" src="' + mapUrl + '" alt="Карта маршрута" />';
        html += '<ol class="pr-list">';
        route.forEach((id, i) => {
          const p = byId[id];
          const c = CATS[p.category];
          const src = srcFor(p);
          html +=
            '<li class="pr-item">' +
            '<div class="pr-num" style="background:' + c.color + '">' + (i + 1) + "</div>" +
            (src
              ? '<img class="pr-thumb" src="' + src + '" alt="" referrerpolicy="no-referrer" />'
              : '<div class="pr-thumb pr-thumb-ph" style="background:' + c.color + '"></div>') +
            '<div class="pr-info">' +
            '<span class="pr-badge" style="background:' + c.color + '">' + c.badge + "</span>" +
            '<div class="pr-name">' + esc(p.name) +
            ' <span class="pr-rating">★ ' + p.rating + "</span></div>" +
            '<div class="pr-meta">' + esc(p.city) + " · " + esc(p.duration) + "</div>" +
            '<div class="pr-desc">' + esc(p.description) + "</div>" +
            "</div></li>";
        });
        html += "</ol>";
        html +=
          '<div class="pr-foot">Составлено на welcomecrimea.ru · ' +
          new Date().toLocaleDateString("ru-RU") + "</div>";
        box.innerHTML = html;
        await waitImages(box, 3500);
        btn.disabled = false;
        btn.textContent = label;
        window.print();
      });

      // share link ?route=
      document.getElementById("route-share").addEventListener("click", async () => {
        const link =
          location.origin + location.pathname + "?route=" + route.join(",");
        try {
          await navigator.clipboard.writeText(link);
          shareHint.textContent = "Ссылка скопирована в буфер обмена.";
        } catch (e) {
          shareHint.textContent = link;
        }
      });

      // ---------- init from URL ----------
      const params = new URLSearchParams(location.search);
      const r = params.get("route");
      if (r) {
        r.split(",").forEach((id) => {
          if (byId[id] && !route.includes(id)) route.push(id);
        });
      }

      refreshPills();
      applyFilters();
      refreshRouteBar();

      // Esc closes overlays
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (modal.classList.contains("open")) closeModal();
          else if (panel.classList.contains("open")) closePanel();
        }
      });
    })();
  </script>
</BaseLayout>

